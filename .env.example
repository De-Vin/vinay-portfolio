# Copy to .env and fill in ONE provider. These values are public by design (they ship to the browser).
# provider: formspree | emailjs | mailto
VITE_CONTACT_PROVIDER=formspree

# Formspree — https://formspree.io → New form → copy the ID from https://formspree.io/f/<ID>
VITE_FORMSPREE_ID=

# EmailJS — https://www.emailjs.com → Email Services, Email Templates, Account → Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
