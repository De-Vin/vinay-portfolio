# Copy to .env and fill in. These values are public by design (they ship to the browser).
# Leave any EmailJS value empty and the form falls back to mailto.
VITE_CONTACT_PROVIDER=emailjs

# EmailJS — https://www.emailjs.com → Email Services, Email Templates, Account → Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
